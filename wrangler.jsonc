{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "athan-waqf-dev",
  "main": "./src/server.ts",
  "account_id": "f1e7c7c68165026fbc0f205ffba26463",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "athan.waqf.dev",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": false
  }
}
